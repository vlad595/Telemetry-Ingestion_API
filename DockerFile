FROM mcr.Microsoft.com/dotnet/sdk:10.0 AS build
WORKDiR /src

COPY ["Ingestion-Telemetry_API.csproj", "./"]
RUN dotnet restore "Ingestion-Telemetry_API.csproj"

COPY . .
RUN dotnet publish "Ingestion-Telemetry_API.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.Microsoft.com/dotnet/sdk:10.0 AS runtime
WORKDIR /app

COPY --from=build /app/publish .

ENTRYPOINT ["dotnet", "Ingestion-Telemetry_API.dll"]